          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/password",
        "description": "Change password and revoke all tokens",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"current_password\": \"YOUR_CURRENT_PASSWORD\",\n  \"password\": \"NewExamplePass123\",\n  \"password_confirmation\": \"NewExamplePass123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/auth/register",
        "description": "Register an unlinked applicant and issue token",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo Applicant\",\n  \"cnic\": \"9999900000003\",\n  \"email\": \"demo.applicant@example.test\",\n  \"phone\": \"03000000000\",\n  \"password\": \"ExamplePass123\",\n  \"password_confirmation\": \"ExamplePass123\",\n  \"device_name\": \"Android\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code < 300) { pm.collectionVariables.set(\"access_token\", pm.response.json().access_token); }"
            ]
          }
        }
      ]
    },
    {
      "name": "POST auth/reset-password",
