{
  "info": {
    "name": "LDA Sports Complex Mobile API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://104.207.64.25/sports-complex/api/mobile/v1"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "challan",
      "value": "1"
    },
    {
      "key": "transaction",
      "value": "TRANSACTION_PUBLIC_UUID"
    },
    {
      "key": "appointment",
      "value": "APPOINTMENT_PUBLIC_ID"
    },
    {
      "key": "notification",
      "value": "1"
    },
    {
      "key": "sportsComplex",
      "value": "COMPLEX_SLUG"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "GET appointment-slots",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/appointment-slots?sports_complex_id=1&date=2026-11-02",
        "description": "Available appointment slots"
      }
    },
    {
      "name": "POST appointments",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/appointments",
        "description": "Book an appointment",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sports_complex_id\": 1,\n  \"appointment_purpose_id\": 1,\n  \"appointment_date\": \"2026-11-02\",\n  \"appointment_time\": \"10:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "GET appointments/{appointment}",
      "request": {
        "method": "GET",
