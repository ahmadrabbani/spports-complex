APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sports_complex
DB_USERNAME=sports_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Public PHP creation endpoint; SAP_CHALLAN_URL remains supported for older installations.
SAP_CHALLAN_PUBLIC_CREATE_URL=http://103.8.115.199:91/sapchallan/index.php
SAP_CHALLAN_INTERNAL_CREATE_URL=http://172.16.130.200:91/sapchallan/index.php
SAP_CHALLAN_TIMEOUT=30
SAP_CHALLAN_AREA=1
SAP_CHALLAN_TYPE=1
MEMBER_DEFAULT_PASSWORD=

# Bank of Punjab Mastercard Payment Gateway Services (MPGS) test environment.
# Keep actual credentials only in the uncommitted .env file.
BOP_MPGS_ENABLED=false
BOP_MPGS_ENVIRONMENT=test
BOP_MPGS_BASE_URL=https://test-gateway.mastercard.com
BOP_MPGS_API_VERSION=73
BOP_MPGS_MERCHANT_ID=
BOP_MPGS_API_PASSWORD=
BOP_MPGS_MERCHANT_NAME="LDA Sports Complex"
BOP_MPGS_WEBHOOK_KEY=
BOP_MPGS_TIMEOUT=30

# Isolated demonstration; real SAP/bank verification never accepts mock records.
PAYMENT_MODE=mock
SAP_BASE_URL=http://172.16.70.8:8080
SAP_CHALLAN_PATH=/SAPVERIFICATION/Challan
SAP_VERIFICATION_PATH=/SAPVERIFICATION/PaymentVerification
SAP_TIMEOUT=30
SAP_CONNECT_TIMEOUT=10

# Optional verification proxy (cid receives the full 18-digit SAP identifier).
SAP_PAYMENT_VERIFICATION_URL=http://103.8.115.199:91/sapchallan/verify.php
SAP_PAYMENT_VERIFICATION_PARAMETER=cid
